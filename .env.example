# ─────────────────────────────────────────────────────────────────────
# Cards of Doons | BOT — Variáveis de Ambiente
# ─────────────────────────────────────────────────────────────────────
# ATENÇÃO: Este é um arquivo de EXEMPLO.
# Copie este arquivo para ".env" e preencha com seus valores reais.
# O arquivo ".env" NUNCA deve ser enviado ao GitHub.
# ─────────────────────────────────────────────────────────────────────

# Token do bot Discord
# Obtido em: https://discord.com/developers/applications
# Vá em Bot > Reset Token > Copie o token
DISCORD_TOKEN=

# API Key da Groq
# Obtida em: https://console.groq.com/keys
# Crie uma conta, gere uma chave e cole aqui
GROQ_API_KEY=

# Modelo da IA (não altere, a menos que a Groq disponibilize novo modelo)
GROQ_MODEL=openai/gpt-oss-120b

# ID do canal de boas-vindas
# Para obter: Ative o Modo Desenvolvedor no Discord (Configurações > Avançado > Modo Desenvolvedor)
# Clique com o botão direito no canal > Copiar ID
WELCOME_CHANNEL_ID=1551208522253869127

# ID da categoria onde os tickets serão criados
# Clique com o botão direito na categoria > Copiar ID
TICKET_CATEGORY_ID=1551209564815228988

# ID do canal de logs do bot (opcional)
# Deixe vazio para desativar os logs de tickets
LOG_CHANNEL_ID=
